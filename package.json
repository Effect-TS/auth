{
  "name": "effect-auth",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "prepare": "effect-tsgo patch",
    "build": "tsc -b tsconfig.packages.json && pnpm --recursive --parallel --filter \"./packages/*\" run build",
    "check": "tsc -b tsconfig.json",
    "test": "vitest",
    "test-types": "tstyche --target '>=5.9'",
    "coverage": "vitest run --coverage",
    "lint": "oxlint -f unix && dprint check",
    "lint-fix": "oxlint --fix && dprint fmt",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@babel/cli": "^8.0.6",
    "@babel/core": "^8.0.7",
    "@changesets/cli": "3.0.3",
    "@effect/platform-node": "4.0.3",
    "@effect/tsgo": "^0.51.1",
    "@effect/vitest": "4.0.3",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.3",
    "@yielded/jose": "workspace:^",
    "babel-plugin-annotate-pure-calls": "^0.5.0",
    "dprint": "^0.61.1",
    "effect": "4.0.3",
    "jose": "6.2.12",
    "oxlint": "^1.87.0",
    "tstyche": "^7.2.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
