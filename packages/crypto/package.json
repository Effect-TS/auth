{
  "name": "@yielded/crypto",
  "version": "0.1.0-beta.38",
  "description": "Effect cryptography services with explicit native and portable backends.",
  "homepage": "https://yielded.dev/auth/",
  "bugs": {
    "url": "https://github.com/Effect-TS/auth/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Effect-TS/auth.git",
    "directory": "packages/crypto"
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "THIRD_PARTY_NOTICES.md",
    "AGENTS.md",
    "CLAUDE.md",
    "ai-docs/**/*",
    "src/internal/argon2-block.c",
    "src/internal/argon2.wasm",
    "dist/internal/argon2.wasm"
  ],
  "type": "module",
  "sideEffects": [],
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./Aead": "./src/Aead.ts",
    "./Errors": "./src/Errors.ts",
    "./Hmac": "./src/Hmac.ts",
    "./Kdf": "./src/Kdf.ts",
    "./KdfAdmission": "./src/KdfAdmission.ts",
    "./Signature": "./src/Signature.ts",
    "./WebCrypto": "./src/WebCrypto.ts",
    "./platform-node": "./src/platform-node.ts",
    "./platform-bun": "./src/platform-bun.ts",
    "./platform-workerd": "./src/platform-workerd.ts",
    "./Portable": "./src/Portable.ts"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      "./package.json": "./package.json",
      ".": "./dist/index.js",
      "./Aead": "./dist/Aead.js",
      "./Errors": "./dist/Errors.js",
      "./Hmac": "./dist/Hmac.js",
      "./Kdf": "./dist/Kdf.js",
      "./KdfAdmission": "./dist/KdfAdmission.js",
      "./Signature": "./dist/Signature.js",
      "./WebCrypto": "./dist/WebCrypto.js",
      "./platform-node": "./dist/platform-node.js",
      "./platform-bun": "./dist/platform-bun.js",
      "./platform-workerd": "./dist/platform-workerd.js",
      "./Portable": "./dist/Portable.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json && pnpm babel && node scripts/copy-assets.mjs",
    "babel": "babel dist --plugins annotate-pure-calls --out-dir dist --source-maps",
    "check": "tsc -b tsconfig.json",
    "docs": "docgen",
    "build:wasm": "clang --target=wasm32 -O3 -msimd128 -ffreestanding -fno-builtin -nostdlib -Wl,--no-entry -Wl,--import-memory -Wl,--export=argon2_block -Wl,--export=__heap_base -Wl,--strip-all src/internal/argon2-block.c -o src/internal/argon2.wasm",
    "codegen": "effect-utils codegen"
  },
  "devDependencies": {
    "effect": "4.0.3"
  },
  "peerDependencies": {
    "effect": "^4.0.3"
  }
}
