{
  "name": "@yielded/oauth",
  "version": "0.1.0-beta.38",
  "description": "Native Effect OAuth and signed OpenID Connect protocols.",
  "homepage": "https://yielded.dev/auth/",
  "bugs": {
    "url": "https://github.com/Effect-TS/auth/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Effect-TS/auth.git",
    "directory": "packages/oauth"
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "THIRD_PARTY_NOTICES.md",
    "AGENTS.md",
    "CLAUDE.md",
    "ai-docs/**/*"
  ],
  "type": "module",
  "sideEffects": [],
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./Errors": "./src/Errors.ts",
    "./OAuth": "./src/OAuth.ts",
    "./Oidc": "./src/Oidc.ts",
    "./Pkce": "./src/Pkce.ts"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      "./package.json": "./package.json",
      ".": "./dist/index.js",
      "./Errors": "./dist/Errors.js",
      "./OAuth": "./dist/OAuth.js",
      "./Oidc": "./dist/Oidc.js",
      "./Pkce": "./dist/Pkce.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json && pnpm babel",
    "babel": "babel dist --plugins annotate-pure-calls --out-dir dist --source-maps",
    "check": "tsc -b tsconfig.json",
    "codegen": "effect-utils codegen",
    "docs": "docgen"
  },
  "devDependencies": {
    "effect": "4.0.3"
  },
  "peerDependencies": {
    "effect": "^4.0.3"
  },
  "dependencies": {
    "@yielded/jose": "workspace:^"
  }
}
